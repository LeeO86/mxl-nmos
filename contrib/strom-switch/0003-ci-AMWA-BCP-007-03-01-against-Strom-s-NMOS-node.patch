+#!/usr/bin/env bash
+# AMWA BCP-007-03-01 against Strom's NMOS node (the mxl-nmos crate).
+#
+#   scripts/nmos-amwa/run.sh <strom-binary>
+#
+# Starts an nmos-cpp registry (Registration API 8010, Query API 8011) and Strom
+# headless with flows.json (one MXL video output, one MXL audio input, not
+# running) and one MXL domain, then runs the suite. Needs docker, an nmos-testing
+# checkout with its requirements in $NMOS_TESTING_DIR / $NMOS_TESTING_PYTHON, and
+# the kernel TAI offset set to 37 s. check_amwa.py fails on any result not listed
+# in expected.json.
+set -euo pipefail
+
+STROM_BIN="${1:?usage: run.sh <strom-binary>}"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+TOOL="${NMOS_TESTING_DIR:?set NMOS_TESTING_DIR}"
+PY="${NMOS_TESTING_PYTHON:?set NMOS_TESTING_PYTHON}"
+OUT="${AMWA_OUT:-$PWD/amwa-out}"
+IMAGE="${NMOS_REGISTRY_IMAGE:-mirror.gcr.io/rhastie/nmos-cpp@sha256:c54c8ded3b61740dbd579c03892b0229842250417aa397d87a92e2b91ba645b8}"
+HOST_IP="${HOST_IP:-$(ip -4 route get 1.1.1.1 | sed -n 's/.* src \([0-9.]*\).*/\1/p')}"
+PORT=3313
+WORK="$(mktemp -d)"
+mkdir -p "$OUT" "$WORK/config" "$WORK/mxl/amwa"
+STROM_PID=""
+
+cleanup() {
+    if [[ -n "$STROM_PID" ]] && kill -0 "$STROM_PID" 2>/dev/null; then
+        kill -TERM "$STROM_PID"
+        wait "$STROM_PID" || true
+    fi
+    docker logs strom-amwa-registry >"$OUT/registry.log" 2>&1 || true
+    docker rm -f strom-amwa-registry >/dev/null 2>&1 || true
+    rm -rf "$WORK"
+}
+trap cleanup EXIT
+
+wait_http() {
+    for _ in $(seq 1 $(($2 * 5))); do
+        curl -fsS -o /dev/null "$1" 2>/dev/null && return 0
+        sleep 0.2
+    done
+    echo "timeout waiting for $1" >&2
+    return 1
+}
+
+docker rm -f strom-amwa-registry >/dev/null 2>&1 || true
+docker run -d --name strom-amwa-registry --network host \
+    -v "$HERE/registry.json:/home/registry.json:ro" "$IMAGE" >/dev/null
+wait_http "http://$HOST_IP:8011/x-nmos/query/v1.3/nodes" 60
+
+cp "$HERE/flows.json" "$WORK/config/flows.json"
+cat >"$WORK/mxl/amwa/domain_def.json" <<'EOF'
+{"id": "3310f209-9351-47c0-b9a2-14c59b6a4c23", "label": "AMWA", "description": "AMWA test domain", "tags": {}}
+EOF
+
+CONFIG_DIR="$WORK/config" PORT="$PORT" NMOS_SEED=strom-amwa NMOS_HOST_ADDRESS="$HOST_IP" \
+    NMOS_REGISTRY_ADDRESS="$HOST_IP" NMOS_REGISTRY_PORT=8010 MXL_DOMAIN_SCAN_PATH="$WORK/mxl" \
+    STROM_NMOS_DOMAINS="$WORK/mxl/amwa" RUST_LOG=info \
+    "$STROM_BIN" --headless >"$OUT/strom.log" 2>&1 &
+STROM_PID=$!
+wait_http "http://$HOST_IP:$PORT/readyz" 60
+
+cat >"$TOOL/nmostesting/UserConfig.py" <<EOF
+from . import Config as CONFIG
+CONFIG.ENABLE_DNS_SD = False
+CONFIG.QUERY_API_HOST = "$HOST_IP"
+CONFIG.QUERY_API_PORT = 8011
+EOF
+set +e
+(cd "$TOOL" && "$PY" nmos-test.py suite BCP-007-03-01 --selection all \
+    --host "$HOST_IP" "$HOST_IP" --port "$PORT" "$PORT" --version v1.3 v1.2 \
+    --output "$OUT/BCP-007-03-01.json") >"$OUT/BCP-007-03-01.log" 2>&1
+echo "BCP-007-03-01 exited $?"
+set -e
+python3 "$HERE/check_amwa.py" "$OUT" "$HERE/expected.json"
