+  # AMWA BCP-007-03-01 against Strom's NMOS node (the mxl-nmos crate), with an
+  # nmos-cpp registry. nmos-testing is installed from source at a pinned commit
+  # and the registry comes from mirror.gcr.io, so nothing is pulled from Docker Hub.
+  nmos-amwa:
+    name: NMOS AMWA BCP-007-03-01
+    if: github.event.action != 'labeled'
+    needs: preflight
+    runs-on: ubuntu-24.04
+    timeout-minutes: 25
+    env:
+      RUSTC_WRAPPER: ${{ needs.preflight.outputs.cache_ok == 'true' && 'sccache' || '' }}
+      NMOS_TESTING_REF: 90018513758e6fbc096c26d7ef001f700b28b510
+    steps:
+      - uses: actions/checkout@v6
+
+      - name: Install Rust stable
+        uses: dtolnay/rust-toolchain@stable
+
+      # Same package list as check-linux, so both jobs share one apt cache entry.
+      - name: Cache apt packages
+        uses: awalsh128/cache-apt-pkgs-action@v1.6.1
+        with:
+          packages: libunwind-dev libssl-dev libcairo2-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libgstreamer-plugins-bad1.0-dev gstreamer1.0-plugins-base gstreamer1.0-gl gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav gstreamer1.0-nice pkg-config cmake libclang-dev
+          version: 1.5
+
+      - name: Cache Rust dependencies
+        uses: Swatinem/rust-cache@v2
+        with:
+          shared-key: linux-x86_64
+          cache-on-failure: true
+          save-if: false
+
+      - name: Setup sccache
+        if: needs.preflight.outputs.cache_ok == 'true'
+        uses: mozilla-actions/sccache-action@v0.0.10
+
+      - name: Build Strom
+        run: cargo build --package strom --features mxl
+
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.12"
+
+      # nmos-testing computes TAI as UTC + 37 s; CLOCK_TAI on the runner is UTC
+      # until the kernel's TAI offset is set.
+      - name: Kernel TAI offset
+        run: |
+          sudo python3 - <<'PY'
+          import ctypes, ctypes.util, time
+          class Timeval(ctypes.Structure):
+              _fields_ = [("s", ctypes.c_long), ("u", ctypes.c_long)]
+          class Timex(ctypes.Structure):
+              _fields_ = [("modes", ctypes.c_uint)] + [(n, ctypes.c_long) for n in ("offset", "freq", "maxerror", "esterror")] + \
+                  [("status", ctypes.c_int)] + [(n, ctypes.c_long) for n in ("constant", "precision", "tolerance")] + \
+                  [("time", Timeval)] + [(n, ctypes.c_long) for n in ("tick", "ppsfreq", "jitter")] + [("shift", ctypes.c_int)] + \
+                  [(n, ctypes.c_long) for n in ("stabil", "jitcnt", "calcnt", "errcnt", "stbcnt")] + [("tai", ctypes.c_int), ("pad", ctypes.c_int * 11)]
+          tx = Timex(modes=0x0080, constant=37)
+          assert ctypes.CDLL(ctypes.util.find_library("c")).adjtimex(ctypes.byref(tx)) >= 0
+          print("TAI-UTC", round(time.clock_gettime(time.CLOCK_TAI) - time.clock_gettime(time.CLOCK_REALTIME), 3))
+          PY
+
+      - name: nmos-testing
+        run: |
+          mkdir -p "$RUNNER_TEMP/nmos-testing"
+          curl -fsSL "https://codeload.github.com/AMWA-TV/nmos-testing/tar.gz/$NMOS_TESTING_REF" |
+            tar xz -C "$RUNNER_TEMP/nmos-testing" --strip-components=1
+          python -m venv "$RUNNER_TEMP/venv"
+          "$RUNNER_TEMP/venv/bin/pip" install -q --disable-pip-version-check -r "$RUNNER_TEMP/nmos-testing/requirements.txt"
+
+      - name: BCP-007-03-01
+        run: scripts/nmos-amwa/run.sh target/debug/strom
+        env:
+          NMOS_TESTING_DIR: ${{ runner.temp }}/nmos-testing
+          NMOS_TESTING_PYTHON: ${{ runner.temp }}/venv/bin/python
+          AMWA_OUT: ${{ runner.temp }}/amwa
+
+      - name: Summary
+        if: always()
+        run: cat "$RUNNER_TEMP/amwa/summary.md" >> "$GITHUB_STEP_SUMMARY" || true
+
+      - uses: actions/upload-artifact@v7
+        if: always()
+        with:
+          name: nmos-amwa
+          path: ${{ runner.temp }}/amwa
+
   # WASM: clippy + build frontend
   check-wasm:
     name: Check & Build (WASM)
