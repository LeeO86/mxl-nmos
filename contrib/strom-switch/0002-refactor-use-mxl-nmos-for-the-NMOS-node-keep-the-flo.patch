-    pub async fn dispatch(
-        &self,
-        method: &str,
-        path: &str,
-        body: &[u8],
-    ) -> Result<(u16, Value), (u16, Value)> {
-        self.sync().await;
-        let parts = split_path(path);
-        match method {
-            "GET" => self.get(&parts),
-            "PATCH" => self.patch(&parts, body).await,
-            "POST" => self.post(&parts, body).await,
-            _ => Err(api_error(405, "method not allowed")),
-        }
-    }
