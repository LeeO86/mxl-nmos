+//! Strom's side of the NMOS node. The node itself is the `mxl-nmos` crate; this
+//! module maps Strom flows to its resources: each flow with MXL blocks is a
+//! Device, an output block a Source + Flow + Sender, an input block a Receiver.
+//! An activation restarts that Strom flow so `mxlsink` / `mxlsrc` pick up the
+//! domain path and flow id.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, MutexGuard};
+use std::time::Duration;
+
+use futures::future::BoxFuture;
+use mxl_nmos::{
+    media_types, Activation, ActiveConnection, AutoRequest, Channel, Component, Device, Flow,
+    Format, NodeImplementation, Param, Rational, Receiver, ReceiverCaps, Rejected, ResourceType,
+    Role, Sender, Source, StagedConnection, Tags, GROUP_HINT_TAG,
+};
+use serde_json::json;
+use strom_types::block::BlockInstance;
+use strom_types::element::PropertyValue;
+use strom_types::mxl::{
+    MXL_AUDIO_INPUT_ID, MXL_AUDIO_OUTPUT_ID, MXL_VIDEO_INPUT_ID, MXL_VIDEO_OUTPUT_ID,
+};
+use strom_types::{Flow as StromFlow, FlowId};
+use uuid::Uuid;
+
+use super::domain::{domain_has_flow, scan_domain_root, scan_domains, MxlDomain};
+use super::settings::NmosSettings;
+
+pub type SnapshotFn = Arc<dyn Fn() -> BoxFuture<'static, Vec<StromFlow>> + Send + Sync>;
+pub type ApplyFn = Arc<dyn Fn(MxlApply) -> BoxFuture<'static, Result<(), String>> + Send + Sync>;
+
+/// Strom's activation handler restarts a flow, which can take several seconds.
+const ACTIVATION_TIMEOUT: Duration = Duration::from_secs(30);
+const SHUTDOWN_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// What an IS-05 activation asks the pipeline to do.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MxlApply {
+    pub flow_id: FlowId,
+    pub block_id: String,
+    pub kind: EndpointKind,
+    pub domain_path: String,
+    pub mxl_flow_id: String,
+    pub master_enable: bool,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum EndpointKind {
+    VideoSender,
+    AudioSender,
+    VideoReceiver,
+    AudioReceiver,
+}
+
+impl EndpointKind {
+    fn is_sender(self) -> bool {
+        matches!(self, Self::VideoSender | Self::AudioSender)
+    }
+
+    fn role(self) -> Role {
+        if self.is_sender() {
+            Role::Sender
+        } else {
+            Role::Receiver
+        }
+    }
+
+    fn from_definition(id: &str) -> Option<Self> {
+        match id {
+            MXL_VIDEO_OUTPUT_ID => Some(Self::VideoSender),
+            MXL_AUDIO_OUTPUT_ID => Some(Self::AudioSender),
+            MXL_VIDEO_INPUT_ID => Some(Self::VideoReceiver),
+            MXL_AUDIO_INPUT_ID => Some(Self::AudioReceiver),
+            _ => None,
+        }
+    }
+}
+
+/// What Strom knows about one MXL block between syncs.
+struct Endpoint {
+    kind: EndpointKind,
+    flow_id: FlowId,
+    block_id: String,
+    running: bool,
+    preferred_domain_path: String,
+    configured_mxl_flow: Option<Uuid>,
+    generated_flow: Option<Uuid>,
+    /// The staged and active state last seeded from the block properties.
+    seeded: Option<(StagedConnection, ActiveConnection)>,
+    /// Patched through IS-05 since it was loaded: stop seeding from the block.
+    dirty: bool,
+}
+
+type Endpoints = Arc<Mutex<HashMap<String, Endpoint>>>;
+
+/// In-memory NMOS node. HTTP handlers and the sync task share it.
+#[derive(Clone)]
+pub struct NmosNode {
+    inner: Arc<Inner>,
+}
+
+struct Inner {
+    settings: NmosSettings,
+    node: mxl_nmos::Node,
+    snapshot: SnapshotFn,
+    endpoints: Endpoints,
+    devices: Mutex<HashSet<FlowId>>,
+    domains: Mutex<Vec<MxlDomain>>,
+    sync_lock: tokio::sync::Mutex<()>,
+    shutdown: AtomicBool,
+    started: AtomicBool,
+}
+
+impl NmosNode {
+    pub fn new(settings: NmosSettings, snapshot: SnapshotFn, apply: ApplyFn) -> Self {
+        let endpoints: Endpoints = Arc::default();
+        let implementation = implementation(&settings, endpoints.clone(), apply);
+        let node =
+            match mxl_nmos::Node::new(crate_settings(&settings, true), implementation.clone()) {
+                Ok(node) => node,
+                Err(err) => {
+                    tracing::error!("NMOS node cannot register: {err}");
+                    mxl_nmos::Node::new(crate_settings(&settings, false), implementation)
+                        .expect("an unregistered node needs no announce address")
+                }
+            };
+        Self {
+            inner: Arc::new(Inner {
+                settings,
+                node,
+                snapshot,
+                endpoints,
+                devices: Mutex::default(),
+                domains: Mutex::default(),
+                sync_lock: tokio::sync::Mutex::new(()),
+                shutdown: AtomicBool::new(false),
+                started: AtomicBool::new(false),
+            }),
+        }
+    }
+
+    pub fn settings(&self) -> &NmosSettings {
+        &self.inner.settings
+    }
+
+    pub fn node_id(&self) -> Uuid {
+        self.inner.node.node_id()
+    }
+
+    pub(crate) fn crate_node(&self) -> &mxl_nmos::Node {
+        &self.inner.node
+    }
+
+    pub fn is_shutdown(&self) -> bool {
+        self.inner.shutdown.load(Ordering::SeqCst)
+    }
+
+    /// Stop the sync task and the registration of this node.
+    pub fn request_shutdown(&self) {
+        if self.inner.shutdown.swap(true, Ordering::SeqCst) {
+            return;
+        }
+        if self.inner.started.load(Ordering::SeqCst) {
+            if let Ok(handle) = tokio::runtime::Handle::try_current() {
+                let node = self.inner.node.clone();
+                handle.spawn(async move { node.shutdown(SHUTDOWN_TIMEOUT).await });
+            }
+        }
+    }
+
+    pub fn mark_started(&self) -> bool {
+        self.inner.started.swap(true, Ordering::SeqCst)
+    }
+
+    /// True after the registry accepted the node, the last heartbeat succeeded and
+    /// the Query API lists it. False when no registry is configured.
+    pub fn is_registered(&self) -> bool {
+        self.inner.node.is_registered()
+    }
+
+    pub fn registry_required(&self) -> bool {
+        self.inner
+            .settings
+            .registry
+            .as_ref()
+            .is_some_and(|url| !url.trim().is_empty())
+    }
+
+    pub(crate) async fn deregister(&self) {
+        self.inner.shutdown.store(true, Ordering::SeqCst);
+        self.inner.node.shutdown(SHUTDOWN_TIMEOUT).await;
+    }
+
+    /// Read the flows and MXL domains and bring the node's resources up to date.
+    pub async fn sync(&self) {
+        let _guard = self.inner.sync_lock.lock().await;
+        let flows = (self.inner.snapshot)().await;
+        let domains = discover_domains(&self.inner.settings);
+        {
+            let mut known = lock(&self.inner.domains);
+            log_domain_changes(&known, &domains);
+            known.clone_from(&domains);
+        }
+        self.sync_flows(&flows, &domains);
+    }
+
+    fn sync_flows(&self, flows: &[StromFlow], domains: &[MxlDomain]) {
+        let node = &self.inner.node;
+        let mut seen = HashSet::new();
+        let mut devices = HashSet::new();
+        for flow in flows {
+            let blocks: Vec<(EndpointKind, &BlockInstance)> = flow
+                .blocks
+                .iter()
+                .filter_map(|b| {
+                    EndpointKind::from_definition(&b.block_definition_id).map(|k| (k, b))
+                })
+                .collect();
+            if blocks.is_empty() {
+                continue;
+            }
+            devices.insert(flow.id);
+            let device_key = flow.id.to_string();
+            let _ = node.insert_device(
+                Device::new(device_key.clone(), flow.name.clone()).description("Strom flow"),
+            );
+            for (kind, block) in blocks {
+                let key = endpoint_key(flow.id, &block.id);
+                seen.insert(key.clone());
+                if let Err(err) = insert_resources(node, &key, &device_key, kind, block, &flow.name)
+                {
+                    tracing::warn!("NMOS resources for block {} not published: {err}", block.id);
+                    continue;
+                }
+                self.sync_connection(&key, kind, flow, block, domains);
+            }
+        }
+        let stale: Vec<(String, EndpointKind)> = {
+            let mut endpoints = lock(&self.inner.endpoints);
+            let stale = endpoints
+                .iter()
+                .filter(|(key, _)| !seen.contains(*key))
+                .map(|(key, ep)| (key.clone(), ep.kind))
+                .collect();
+            endpoints.retain(|key, _| seen.contains(key));
+            stale
+        };
+        for (key, kind) in stale {
+            let typ = if kind.is_sender() {
+                ResourceType::Source
+            } else {
+                ResourceType::Receiver
+            };
+            let _ = node.erase(typ, &key);
+        }
+        let mut known = lock(&self.inner.devices);
+        for gone in known.difference(&devices) {
+            let _ = node.erase(ResourceType::Device, &gone.to_string());
+        }
+        *known = devices;
+    }
+
+    /// Seed staged and active from the block properties until an IS-05 PATCH
+    /// touches the endpoint; after that only `master_enable` follows the flow's
+    /// running state (as Strom 1.0.1 did).
+    fn sync_connection(
+        &self,
+        key: &str,
+        kind: EndpointKind,
+        flow: &StromFlow,
+        block: &BlockInstance,
+        domains: &[MxlDomain],
+    ) {
+        let node = &self.inner.node;
+        let role = kind.role();
+        let mut endpoints = lock(&self.inner.endpoints);
+        let configured = configured_flow_id(block, kind);
+        let preferred = prop_string(&block.properties, "domain");
+        let endpoint = endpoints
+            .entry(key.to_string())
+            .or_insert_with(|| Endpoint {
+                kind,
+                flow_id: flow.id,
+                block_id: block.id.clone(),
+                running: flow.running,
+                preferred_domain_path: preferred.clone(),
+                configured_mxl_flow: configured,
+                generated_flow: None,
+                seeded: None,
+                dirty: false,
+            });
+        endpoint.running = flow.running;
+        endpoint.preferred_domain_path = preferred;
+        endpoint.configured_mxl_flow = configured;
+        if let Some((staged, _)) = &endpoint.seeded {
+            if !endpoint.dirty && node.staged(role, key).as_ref() != Some(staged) {
+                endpoint.dirty = true;
+            }
+        }
+        if !endpoint.dirty {
+            let seeded = seed(endpoint, domains);
+            if endpoint.seeded.as_ref() != Some(&seeded) {
+                let _ = node.set_staged(role, key, seeded.0.clone());
+                let _ = node.set_active(role, key, seeded.1.clone());
+                endpoint.seeded = Some(seeded);
+            }
+        } else if let Some(active) = node.active(role, key) {
+            let master_enable = endpoint.running && active.mxl_flow_id.is_some();
+            if active.master_enable != master_enable {
+                let _ = node.set_active(
+                    role,
+                    key,
+                    ActiveConnection {
+                        master_enable,
+                        ..active
+                    },
+                );
+            }
+        }
+    }
+}
+
+fn crate_settings(settings: &NmosSettings, registration: bool) -> mxl_nmos::Settings {
+    let mut s = mxl_nmos::Settings::new(settings.label.clone(), settings.port);
+    s.description = "Strom NMOS node for MXL".to_string();
+    s.seed = settings.seed.clone().filter(|seed| !seed.is_empty());
+    s.node_id = settings.node_id;
+    s.id_path = settings.id_path.clone();
+    s.tags = settings
+        .tags
+        .iter()
+        .map(|(k, v)| (k.clone(), v.clone()))
+        .collect();
+    s.host = settings.host.as_deref().and_then(|h| h.trim().parse().ok());
+    s.https = settings.https;
+    s.registration = registration && settings.enabled;
+    s.registry = settings
+        .registry
+        .clone()
+        .filter(|url| !url.trim().is_empty());
+    s.query = settings.query_base.clone();
+    s.dns_sd = settings.dns_sd;
+    s.service_name_prefix = "strom".to_string();
+    s.heartbeat = Duration::from_secs(settings.heartbeat_secs.max(1));
+    s.activation_timeout = ACTIVATION_TIMEOUT;
+    s
+}
+
+fn implementation(
+    settings: &NmosSettings,
+    endpoints: Endpoints,
+    apply: ApplyFn,
+) -> NodeImplementation {
+    let for_activation = endpoints.clone();
+    let for_domains = settings.clone();
+    NodeImplementation::new(move |activation: Activation| {
+        let endpoints = for_activation.clone();
+        let apply = apply.clone();
+        Box::pin(async move {
+            let (kind, flow_id, block_id, running) = {
+                let mut map = lock(&endpoints);
+                let endpoint = map
+                    .get_mut(&activation.key)
+                    .ok_or_else(|| Rejected("sender or receiver not found".to_string()))?;
+                endpoint.dirty = true;
+                (
+                    endpoint.kind,
+                    endpoint.flow_id,
+                    endpoint.block_id.clone(),
+                    endpoint.running,
+                )
+            };
+            if activation.master_enable && activation.mxl_flow_id.is_none() {
+                return Err(Rejected("mxl_flow_id could not be resolved".to_string()));
+            }
+            if activation.master_enable && activation.mxl_domain_id.is_none() {
+                return Err(Rejected("mxl_domain_id could not be resolved".to_string()));
+            }
+            let domain_path = match activation.mxl_domain_id {
+                Some(_) => activation
+                    .domain_path
+                    .map(|path| path.display().to_string())
+                    .ok_or_else(|| Rejected("resolved MXL domain is not mounted".to_string()))?,
+                None => String::new(),
+            };
+            if activation.master_enable || running {
+                apply(MxlApply {
+                    flow_id,
+                    block_id,
+                    kind,
+                    domain_path,
+                    mxl_flow_id: activation
+                        .mxl_flow_id
+                        .map(|id| id.to_string())
+                        .unwrap_or_default(),
+                    master_enable: activation.master_enable,
+                })
+                .await
+                .map_err(Rejected)?;
+            }
+            Ok(())
+        })
+    })
+    .on_resolve_auto(move |request: &AutoRequest| {
+        let mut map = lock(&endpoints);
+        let endpoint = map
+            .get_mut(&request.key)
+            .ok_or_else(|| "sender or receiver not found".to_string())?;
+        let domain = match request.mxl_domain_id {
+            Param::Null => None,
+            Param::Id(id) => Some(id),
+            Param::Auto => Some(resolve_auto_domain(endpoint, request)?),
+        };
+        let flow = match request.mxl_flow_id {
+            Param::Null => None,
+            Param::Id(id) => Some(id),
+            Param::Auto if endpoint.kind.is_sender() => {
+                let id = endpoint
+                    .configured_mxl_flow
+                    .or(endpoint.generated_flow)
+                    .unwrap_or_else(Uuid::new_v4);
+                endpoint.generated_flow = Some(id);
+                Some(id)
+            }
+            Param::Auto => return Err("receivers must not accept auto for mxl_flow_id".to_string()),
+        };
+        Ok((domain, flow))
+    })
+    .domains(move || {
+        discover_domains(&for_domains)
+            .into_iter()
+            .map(|d| mxl_nmos::MxlDomain {
+                id: d.id,
+                label: d.label,
+                path: d.path,
+            })
+            .collect()
+    })
+}
+
+fn resolve_auto_domain(endpoint: &Endpoint, request: &AutoRequest) -> Result<Uuid, String> {
+    let domains = &request.domains;
+    if let Some(domain) = domains
+        .iter()
+        .find(|d| d.path.display().to_string() == endpoint.preferred_domain_path)
+    {
+        return Ok(domain.id);
+    }
+    if let [only] = domains.as_slice() {
+        return Ok(only.id);
+    }
+    if !endpoint.kind.is_sender() {
+        if let Param::Id(flow_id) = request.mxl_flow_id {
+            if let Some(domain) = domains.iter().find(|d| domain_has_flow(&d.path, flow_id)) {
+                return Ok(domain.id);
+            }
+        }
+    }
+    Err("auto mxl_domain_id could not be resolved".to_string())
+}
+
+fn seed(endpoint: &Endpoint, domains: &[MxlDomain]) -> (StagedConnection, ActiveConnection) {
+    let domain = domains
+        .iter()
+        .find(|d| d.path.display().to_string() == endpoint.preferred_domain_path)
+        .map(|d| d.id)
+        .or_else(|| (domains.len() == 1).then(|| domains[0].id));
+    let master_enable = endpoint.running && endpoint.configured_mxl_flow.is_some();
+    (
+        StagedConnection {
+            master_enable,
+            peer_id: None,
+            mxl_domain_id: domain.into(),
+            mxl_flow_id: endpoint.configured_mxl_flow.into(),
+        },
+        ActiveConnection {
+            master_enable,
+            peer_id: None,
+            mxl_domain_id: domain,
+            mxl_flow_id: endpoint.configured_mxl_flow,
+        },
+    )
+}
+
+fn insert_resources(
+    node: &mxl_nmos::Node,
+    key: &str,
+    device_key: &str,
+    kind: EndpointKind,
+    block: &BlockInstance,
+    flow_name: &str,
+) -> Result<(), mxl_nmos::Error> {
+    let label = block
+        .name
+        .clone()
+        .filter(|name| !name.is_empty())
+        .unwrap_or_else(|| default_label(kind));
+    let tags = hint_tags(&prop_string(&block.properties, "group_hint"));
+    match kind {
+        EndpointKind::VideoSender | EndpointKind::AudioSender => {
+            let mut source = if kind == EndpointKind::VideoSender {
+                Source::video(key, device_key)
+            } else {
+                Source::audio(
+                    key,
+                    device_key,
+                    vec![Channel::new("Channel 1"), Channel::new("Channel 2")],
+                )
+            };
+            source.label = label.clone();
+            source.description = format!("Source for {flow_name}");
+            source.tags = tags.clone();
+            node.insert_source(source)?;
+            let mut flow = if kind == EndpointKind::VideoSender {
+                Flow::video(
+                    key,
+                    key,
+                    device_key,
+                    media_types::VIDEO_V210,
+                    Rational::new(50, 1),
+                    1920,
+                    1080,
+                    Component::ycbcr_422(1920, 1080, 10),
+                )
+            } else {
+                Flow::audio(
+                    key,
+                    key,
+                    device_key,
+                    media_types::AUDIO_FLOAT32,
+                    Rational::new(48_000, 1),
+                    Some(32),
+                )
+            };
+            flow.label = label.clone();
+            flow.description = format!("Flow for {flow_name}");
+            flow.tags = tags.clone();
+            node.insert_flow(flow)?;
+            let mut sender = Sender::mxl(key, key, device_key);
+            sender.label = label;
+            sender.description = format!("MXL sender in {flow_name}");
+            sender.tags = tags;
+            sender.mxl_flow_id = configured_flow_id(block, kind);
+            node.insert_sender(sender)
+        }
+        EndpointKind::VideoReceiver | EndpointKind::AudioReceiver => {
+            let (format, media_type, constraints) = receiver_caps(kind);
+            let mut receiver = Receiver::mxl(key, device_key, format, vec![media_type.to_string()]);
+            receiver.label = label;
+            receiver.description = format!("MXL receiver in {flow_name}");
+            receiver.tags = tags;
+            receiver.caps = ReceiverCaps {
+                media_types: vec![media_type.to_string()],
+                constraint_sets: vec![constraints],
+                // BCP-004-01 requires a version whenever constraint_sets is present.
+                // These caps are fixed for the life of the node.
+                version: Some("0:0".to_string()),
+            };
+            node.insert_receiver(receiver)
+        }
+    }
+}
+
+fn receiver_caps(kind: EndpointKind) -> (Format, &'static str, serde_json::Value) {
+    match kind {
+        EndpointKind::VideoReceiver | EndpointKind::VideoSender => (
+            Format::Video,
+            media_types::VIDEO_V210,
+            json!({
+                "urn:x-nmos:cap:format:frame_width": {"enum": [1920]},
+                "urn:x-nmos:cap:format:frame_height": {"enum": [1080]},
+                "urn:x-nmos:cap:format:grain_rate": {"enum": [
+                    {"numerator": 25, "denominator": 1},
+                    {"numerator": 30, "denominator": 1},
+                    {"numerator": 50, "denominator": 1},
+                    {"numerator": 60, "denominator": 1}
+                ]},
+                "urn:x-nmos:cap:format:interlace_mode": {"enum": ["progressive"]},
+                "urn:x-nmos:cap:format:color_sampling": {"enum": ["YCbCr-4:2:2"]},
+                "urn:x-nmos:cap:format:component_depth": {"enum": [10]}
+            }),
+        ),
+        EndpointKind::AudioReceiver | EndpointKind::AudioSender => (
+            Format::Audio,
+            media_types::AUDIO_FLOAT32,
+            json!({
+                "urn:x-nmos:cap:format:channel_count": {"enum": [1, 2, 4, 8, 16]},
+                "urn:x-nmos:cap:format:sample_rate": {"enum": [{"numerator": 48000, "denominator": 1}]},
+                "urn:x-nmos:cap:format:sample_depth": {"enum": [32]}
+            }),
+        ),
+    }
+}
+
+fn hint_tags(group_hint: &str) -> Tags {
+    let mut tags = Tags::new();
+    if !group_hint.is_empty() {
+        tags.insert(GROUP_HINT_TAG.to_string(), vec![group_hint.to_string()]);
+    }
+    tags
+}
+
+fn configured_flow_id(block: &BlockInstance, kind: EndpointKind) -> Option<Uuid> {
+    let key = match kind {
+        EndpointKind::VideoSender | EndpointKind::AudioSender => "flow_id",
+        EndpointKind::VideoReceiver => "video_flow_id",
+        EndpointKind::AudioReceiver => "audio_flow_id",
+    };
+    Uuid::parse_str(prop_string(&block.properties, key).trim()).ok()
+}
+
+fn prop_string(properties: &HashMap<String, PropertyValue>, key: &str) -> String {
+    match properties.get(key) {
+        Some(PropertyValue::String(value)) => value.clone(),
+        _ => String::new(),
+    }
+}
+
+fn endpoint_key(flow_id: FlowId, block_id: &str) -> String {
+    format!("{flow_id}:{block_id}")
+}
+
+fn default_label(kind: EndpointKind) -> String {
+    match kind {
+        EndpointKind::VideoSender => "MXL Video Output",
+        EndpointKind::AudioSender => "MXL Audio Output",
+        EndpointKind::VideoReceiver => "MXL Video Input",
+        EndpointKind::AudioReceiver => "MXL Audio Input",
+    }
+    .to_string()
+}
+
+fn discover_domains(settings: &NmosSettings) -> Vec<MxlDomain> {
+    let mut domains = scan_domains(&settings.domain_paths);
+    domains.extend(scan_domain_root(&settings.scan_path));
+    if let Some(dir) = &settings.output_domain_dir {
+        domains.extend(scan_domains(std::slice::from_ref(dir)));
+    }
+    domains.sort_by_key(|domain| domain.id);
+    domains.dedup_by_key(|domain| domain.id);
+    domains
+}
+
+/// The domain scan runs every second; log only domains that appeared or went away.
+fn log_domain_changes(old: &[MxlDomain], new: &[MxlDomain]) {
+    for domain in new {
+        if !old
+            .iter()
+            .any(|o| o.id == domain.id && o.path == domain.path)
+        {
+            tracing::info!(
+                "NMOS MXL domain {} ({}) at {}",
+                domain.id,
+                domain.name(),
+                domain.path.display()
+            );
+        }
+    }
+    for domain in old {
+        if !new.iter().any(|n| n.id == domain.id) {
+            tracing::info!(
+                "NMOS MXL domain {} at {} is gone",
+                domain.id,
+                domain.path.display()
+            );
+        }
+    }
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(|err| err.into_inner())
+}
